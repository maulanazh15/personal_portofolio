---
import ArrowRight from '@/components/ui/ArrowRight.astro';
import ArrowUpRight from '@/components/ui/ArrowUpRight.astro';
import { SITE } from '@/data/site';
import { getHome } from '@/i18n/home';
import { routePaths, type Locale } from '@/i18n/config';
import { getUI } from '@/i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getUI(lang);
const copy = getHome(lang).contact;
const host = new URL(SITE.url).host;
---

<section class="pb-20 sm:pb-24 lg:pb-28">
  <div class="container-page">
    <div class="relative isolate overflow-hidden rounded-panel bg-inverse px-7 py-11 text-on-inverse sm:px-10 sm:py-14 lg:px-14 lg:py-16">
      <div class="panel-grid absolute inset-0 -z-10" aria-hidden="true"></div>
      <div
        class="pointer-events-none absolute -right-24 -top-32 -z-10 h-96 w-96 rounded-full bg-accent/25 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="eyebrow text-on-inverse/55">{copy.eyebrow}</p>
          <h2 class="mt-4 max-w-2xl text-3xl font-semibold leading-[1.08] tracking-[-0.035em] text-on-inverse sm:text-4xl lg:text-[2.8rem]">
            {copy.title}
          </h2>
          <p class="mt-5 max-w-xl text-sm leading-relaxed text-on-inverse/65 sm:text-base">
            {copy.description}
          </p>
        </div>

        <div class="flex flex-wrap gap-3 lg:col-span-5 lg:justify-end">
          <a
            href={routePaths.contact[lang]}
            class="btn bg-on-inverse text-inverse hover:bg-on-inverse/90"
          >
            {t.actions.startConversation}
            <ArrowUpRight />
          </a>
          <a
            href={routePaths.projects[lang]}
            class="btn border border-on-inverse/15 text-on-inverse hover:border-on-inverse/35"
          >
            {t.actions.viewAllProjects}
            <ArrowRight />
          </a>
        </div>
      </div>

      <div class="mt-12 flex flex-col gap-2 border-t border-on-inverse/10 pt-5 text-[0.625rem] font-semibold uppercase tracking-[0.15em] text-on-inverse/40 sm:flex-row sm:items-center sm:justify-between">
        <p>{copy.footerNote}</p>
        <p>{host}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .panel-grid {
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.045) 1px, transparent 1px);
    background-size: 2.5rem 2.5rem;
    mask-image: linear-gradient(to bottom, black, transparent 88%);
  }
</style>
