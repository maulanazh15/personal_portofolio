---
import ArrowUpRight from '@/components/ui/ArrowUpRight.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getHome } from '@/i18n/home';
import { getProjectsMessages } from '@/i18n/projects';
import { routePaths, type Locale } from '@/i18n/config';
import { getUI } from '@/i18n/ui';
import { getProjects } from '@/lib/content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getUI(lang);
const copy = getHome(lang).projects;
const labels = getProjectsMessages(lang);
const projects = await getProjects(lang);
---

<section class="section">
  <div class="container-page">
    <SectionHeading
      eyebrow={copy.eyebrow}
      title={copy.title}
      description={copy.description}
      link={{ href: routePaths.projects[lang], label: t.actions.viewAllProjects }}
    />

    <div class="mt-12 grid gap-5 lg:grid-cols-2">
      {projects.map(({ entry, path }) => (
        <a
          href={path}
          class="surface-card group flex flex-col p-7 transition-all duration-300 ease-soft hover:-translate-y-1 hover:border-line-strong hover:shadow-lift sm:p-8"
        >
          <div class="flex flex-wrap items-center gap-2">
            <span class="tag border-accent/20 bg-accent-soft text-accent-ink">{entry.data.category}</span>
            <span class="text-[0.625rem] font-semibold uppercase tracking-[0.14em] text-faint">
              {entry.data.status}
            </span>
          </div>

          <h3 class="mt-5 font-display text-2xl font-semibold tracking-[-0.03em]">
            {entry.data.title}
          </h3>
          <p class="mt-3 max-w-lg text-sm leading-relaxed text-muted">
            {entry.data.summary}
          </p>

          <div class="mt-auto flex flex-wrap items-center justify-between gap-4 pt-8">
            <ul class="flex flex-wrap gap-1.5">
              {entry.data.stack.slice(0, 4).map((item) => (
                <li>
                  <span class="tag bg-canvas">{item}</span>
                </li>
              ))}
            </ul>
            <span class="link-arrow text-accent">
              {labels.viewProject}
              <ArrowUpRight />
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
