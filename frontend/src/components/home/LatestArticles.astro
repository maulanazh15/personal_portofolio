---
import ArrowUpRight from '@/components/ui/ArrowUpRight.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getBlog } from '@/i18n/blog';
import { getHome } from '@/i18n/home';
import { localeMeta, routePaths, type Locale } from '@/i18n/config';
import { getUI } from '@/i18n/ui';
import { getArticles, readingMinutes } from '@/lib/content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getUI(lang);
const copy = getHome(lang).articles;
const labels = getBlog(lang);
const articles = (await getArticles(lang)).slice(0, 2);

const dateFormat = new Intl.DateTimeFormat(localeMeta[lang].dateLocale, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<section class="section">
  <div class="container-page">
    <SectionHeading
      eyebrow={copy.eyebrow}
      title={copy.title}
      description={copy.description}
      link={{ href: routePaths.blog[lang], label: t.actions.viewAllArticles }}
    />

    <ul class="mt-12 border-t border-line">
      {articles.map(({ entry, path }) => (
        <li class="border-b border-line">
          <a
            href={path}
            class="group flex flex-col gap-4 py-7 lg:flex-row lg:items-start lg:justify-between lg:gap-10"
          >
            <div class="lg:max-w-2xl">
              <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.625rem] font-semibold uppercase tracking-[0.16em] text-faint">
                <span>{copy.journalLabel} / {entry.data.category}</span>
                <span aria-hidden="true">·</span>
                <time datetime={entry.data.publishedAt.toISOString()}>
                  {dateFormat.format(entry.data.publishedAt)}
                </time>
                <span aria-hidden="true">·</span>
                <span>{labels.minRead(readingMinutes(entry.body))}</span>
              </p>
              <h3 class="mt-3 font-display text-2xl font-semibold tracking-[-0.03em] transition-colors group-hover:text-accent">
                {entry.data.title}
              </h3>
              <p class="mt-2 max-w-xl text-sm leading-relaxed text-muted">
                {entry.data.description}
              </p>
            </div>

            <span class="link-arrow shrink-0 text-accent lg:mt-1">
              {labels.readArticle}
              <ArrowUpRight />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
