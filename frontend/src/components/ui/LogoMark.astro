---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 32 32"
  fill="none"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <rect width="32" height="32" rx="9" class="fill-inverse"></rect>
  <path
    d="M9.75 21.5V10.5L22.25 21.5V10.5"
    class="stroke-on-inverse"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <circle
    cx="25.5"
    cy="25.5"
    r="4"
    class="fill-accent-solid stroke-on-inverse"
    stroke-width="1.5"></circle>
</svg>
