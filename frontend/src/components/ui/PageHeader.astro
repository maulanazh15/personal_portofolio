---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  meta?: string[];
}

const { eyebrow, title, description, meta } = Astro.props;
---

<header class="container-page pb-12 pt-16 sm:pt-20 lg:pb-16 lg:pt-24">
  <p class="eyebrow">{eyebrow}</p>

  <h1 class="mt-6 max-w-4xl text-[clamp(2.35rem,4.8vw,3.6rem)] font-semibold leading-[1.02] tracking-[-0.045em]">
    {title}
  </h1>

  {description && (
    <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
      {description}
    </p>
  )}

  {meta && meta.length > 0 && (
    <ul class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-line pt-5 text-[0.625rem] font-semibold uppercase tracking-[0.15em] text-faint">
      {meta.map((item) => (
        <li class="flex items-center gap-2">
          <span class="h-1 w-1 rounded-full bg-line-strong" aria-hidden="true"></span>
          {item}
        </li>
      ))}
    </ul>
  )}

  <slot />
</header>
