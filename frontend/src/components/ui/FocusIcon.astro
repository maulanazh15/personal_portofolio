---
import type { ExpertiseIcon } from '@/i18n/expertise';

interface Props {
  name: ExpertiseIcon;
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  {name === 'code' && (
    <>
      <path d="m8 7-5 5 5 5"></path>
      <path d="m16 7 5 5-5 5"></path>
      <path d="m14 4-4 16"></path>
    </>
  )}
  {name === 'stack' && (
    <>
      <path d="M12 3 3 7.5 12 12l9-4.5L12 3Z"></path>
      <path d="m3 12 9 4.5 9-4.5"></path>
      <path d="m3 16.5 9 4.5 9-4.5"></path>
    </>
  )}
  {name === 'ledger' && (
    <>
      <path d="M5 4.5A2.5 2.5 0 0 1 7.5 2H19v17H7.5A2.5 2.5 0 0 0 5 21.5v-17Z"></path>
      <path d="M9 7h6"></path>
      <path d="M9 11h6"></path>
      <path d="M9 15h3"></path>
    </>
  )}
  {name === 'chart' && (
    <>
      <path d="M4 4v16h16"></path>
      <path d="m7.5 14.5 3.5-4 3 2.5 4.5-6"></path>
    </>
  )}
</svg>
