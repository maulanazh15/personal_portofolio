---
import {
  localeMeta,
  locales,
  routePaths,
  type Locale,
  type RouteKey,
} from '@/i18n/config';
import { getUI } from '@/i18n/ui';

interface Props {
  lang: Locale;
  routeKey: RouteKey;
  /** Explicit per-locale targets, used on detail pages with localized slugs. */
  paths?: Partial<Record<Locale, string>>;
}

const { lang, routeKey, paths } = Astro.props;
const t = getUI(lang);
---

<nav aria-label={t.a11y.languageSwitcher}>
  <ul class="flex items-center gap-0.5 rounded-full border border-line bg-surface p-0.5">
    {locales.map((locale) => {
      const current = locale === lang;
      return (
        <li>
          <a
            href={paths?.[locale] ?? routePaths[routeKey][locale]}
            hreflang={localeMeta[locale].htmlLang}
            lang={localeMeta[locale].htmlLang}
            title={localeMeta[locale].nativeName}
            aria-current={current ? 'true' : undefined}
            class:list={[
              'inline-flex min-h-8 items-center rounded-full px-2.5 text-[0.625rem] font-bold uppercase tracking-[0.14em] transition-colors duration-200',
              current
                ? 'bg-ink text-on-ink'
                : 'text-muted hover:bg-canvas hover:text-ink',
            ]}
          >
            <span aria-hidden="true">{localeMeta[locale].shortLabel}</span>
            <span class="sr-only">{localeMeta[locale].nativeName}</span>
          </a>
        </li>
      );
    })}
  </ul>
</nav>
