---
import type { Locale } from '@/i18n/config';
import { getUI } from '@/i18n/ui';

interface Props {
  lang: Locale;
  /** `md` keeps the 44px touch target; `sm` matches desktop header controls. */
  size?: 'sm' | 'md';
  class?: string;
}

const { lang, size = 'md', class: className } = Astro.props;
const t = getUI(lang);
---

<button
  type="button"
  class:list={[
    'theme-toggle inline-flex shrink-0 items-center justify-center rounded-full border border-line bg-surface text-ink transition-colors hover:border-line-strong hover:text-accent',
    size === 'sm' ? 'h-9 w-9' : 'h-11 w-11',
    className,
  ]}
  data-theme-toggle
  data-label-light={t.a11y.switchToLight}
  data-label-dark={t.a11y.switchToDark}
  aria-label={t.a11y.switchToDark}
  title={t.a11y.switchToDark}
>
  <svg
    data-theme-icon="moon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="h-[1.05rem] w-[1.05rem]"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M20.5 14.2A8.4 8.4 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z"></path>
  </svg>
  <svg
    data-theme-icon="sun"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="h-[1.05rem] w-[1.05rem]"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"></path>
  </svg>
</button>
