---
import ArrowUpRight from '@/components/ui/ArrowUpRight.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getProjectsMessages } from '@/i18n/projects';
import { getUI } from '@/i18n/ui';
import { getProjects } from '@/lib/content';
import type { Locale } from '@/i18n/config';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const labels = getProjectsMessages(lang);
const page = getUI(lang).pages.projects;
const projects = await getProjects(lang);
---

<BaseLayout
  lang={lang}
  routeKey="projects"
  title={page.title}
  description={page.description}
>
  <PageHeader
    eyebrow={labels.eyebrow}
    title={labels.title}
    description={labels.description}
    meta={[`${projects.length} ${labels.countLabel}`]}
  />

  <div class="container-page pb-20 lg:pb-28">
    <ul class="space-y-5">
      {projects.map(({ entry, path }) => (
        <li>
          <a
            href={path}
            class="surface-card group grid gap-6 p-7 transition-all duration-300 ease-soft hover:-translate-y-1 hover:border-line-strong hover:shadow-lift sm:p-9 lg:grid-cols-12 lg:gap-10"
          >
            <div class="lg:col-span-8">
              <p class="flex flex-wrap items-center gap-2 text-[0.625rem] font-semibold uppercase tracking-[0.16em] text-accent">
                <span>{entry.data.category}</span>
                <span class="text-line-strong" aria-hidden="true">/</span>
                <span class="text-faint">{entry.data.focus}</span>
              </p>

              <h2 class="mt-4 font-display text-2xl font-semibold tracking-[-0.03em] transition-colors group-hover:text-accent sm:text-3xl">
                {entry.data.title}
              </h2>
              {entry.data.subtitle && (
                <p class="mt-1.5 text-sm text-muted">{entry.data.subtitle}</p>
              )}

              <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ink-soft">
                {entry.data.summary}
              </p>

              <ul class="mt-5 flex flex-wrap gap-1.5">
                {entry.data.stack.map((item) => (
                  <li>
                    <span class="tag bg-canvas">{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="flex items-end justify-between gap-4 lg:col-span-4 lg:flex-col lg:items-end lg:justify-between">
              <span class="tag border-line-strong bg-surface">{entry.data.status}</span>
              <span class="link-arrow text-accent">
                {labels.viewProject}
                <ArrowUpRight />
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
