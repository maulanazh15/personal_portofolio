---
import ArrowUpRight from '@/components/ui/ArrowUpRight.astro';
import ContactForm from '@/components/contact/ContactForm';
import PageHeader from '@/components/ui/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { mailtoHref, SITE } from '@/data/site';
import { getContact } from '@/i18n/contact';
import { getUI } from '@/i18n/ui';
import type { Locale } from '@/i18n/config';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = getContact(lang);
const page = getUI(lang).pages.contact;
const email = SITE.contactEmail;
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_API_URL ?? '/api/v1/contact';
---

<BaseLayout lang={lang} routeKey="contact" title={page.title} description={page.description}>
  <PageHeader eyebrow={copy.eyebrow} title={copy.title} description={copy.description} />

  <div class="container-page pb-20 lg:pb-28">
    <div class="grid gap-5 lg:grid-cols-12">
      <div class="surface-card flex flex-col p-7 sm:p-9 lg:col-span-7">
        <p class="text-[0.625rem] font-semibold uppercase tracking-[0.14em] text-faint">
          {copy.emailLabel}
        </p>
        <a
          href={mailtoHref(email)}
          class="mt-3 break-all font-display text-2xl font-semibold tracking-[-0.03em] text-ink transition-colors hover:text-accent sm:text-3xl"
        >
          {email}
        </a>
        <p class="mt-5 max-w-md text-sm leading-relaxed text-muted">{copy.replyNote}</p>

        <div class="mt-auto flex items-center gap-3 border-t border-line pt-6">
          <span class="text-[0.625rem] font-semibold uppercase tracking-[0.14em] text-faint">
            {copy.locationLabel}
          </span>
          <span class="text-sm text-ink-soft">{SITE.location}</span>
        </div>
      </div>

      <div class="rounded-card border border-line bg-surface p-7 sm:p-9 lg:col-span-5">
        <p class="text-[0.625rem] font-semibold uppercase tracking-[0.14em] text-faint">
          {copy.profilesLabel}
        </p>
        <ul class="mt-3 divide-y divide-line">
          {SITE.socialLinks.map((profile) => (
            <li>
              <a
                href={profile.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center justify-between gap-4 py-3 text-sm font-medium text-ink-soft transition-colors hover:text-accent"
              >
                {profile.label}
                <ArrowUpRight />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <section class="mt-5 surface-card p-7 sm:p-9" aria-labelledby="contact-form-title">
      <h2 id="contact-form-title" class="font-display text-2xl font-semibold tracking-[-0.03em]">
        {copy.formTitle}
      </h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">{copy.formDescription}</p>

      <ContactForm
        client:idle
        endpoint={contactEndpoint}
        locale={lang}
        labels={copy.form}
      />
      <noscript>
        <p class="mt-6 text-sm leading-relaxed text-muted">{copy.form.noScriptNote}</p>
      </noscript>
    </section>

    <div class="mt-5 rounded-panel bg-ink px-7 py-10 text-white sm:px-10 sm:py-12">
      <h2 class="max-w-2xl text-2xl font-semibold leading-[1.15] tracking-[-0.03em] text-white sm:text-3xl">
        {copy.closingTitle}
      </h2>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-white/65 sm:text-base">
        {copy.closingBody}
      </p>
    </div>
  </div>
</BaseLayout>
