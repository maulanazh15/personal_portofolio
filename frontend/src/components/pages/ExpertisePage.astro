---
import FocusIcon from '@/components/ui/FocusIcon.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getExpertise } from '@/i18n/expertise';
import type { Locale } from '@/i18n/config';
import { getUI } from '@/i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = getExpertise(lang);
const page = getUI(lang).pages.expertise;
---

<BaseLayout lang={lang} routeKey="expertise" title={page.title} description={page.description}>
  <PageHeader
    eyebrow={copy.eyebrow}
    title={copy.title}
    description={copy.description}
    meta={[`${copy.groups.length} ${copy.groupsLabel}`]}
  />

  <div class="container-page pb-20 lg:pb-28">
    <div class="grid gap-5 lg:grid-cols-2">
      {copy.groups.map((group, index) => (
        <article class="surface-card flex flex-col p-7 sm:p-8">
          <div class="flex items-start justify-between gap-4">
            <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-accent-soft text-accent">
              <FocusIcon name={group.icon} />
            </span>
            <span class="text-[0.625rem] font-semibold tracking-[0.16em] text-faint">
              0{index + 1}
            </span>
          </div>

          <h2 class="mt-6 font-display text-xl font-semibold tracking-[-0.025em]">
            {group.title}
          </h2>
          <p class="mt-2 text-sm text-muted">{group.description}</p>

          <ul class="mt-6 grid gap-x-6 gap-y-2 sm:grid-cols-2">
            {group.items.map((item) => (
              <li class="flex items-start gap-2 border-b border-line py-2 text-sm text-ink-soft">
                <span class="mt-[0.5rem] h-1 w-1 shrink-0 rounded-full bg-line-strong" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>

          {group.technologies.length > 0 && (
            <div class="mt-auto pt-6">
              <p class="text-[0.625rem] font-semibold uppercase tracking-[0.14em] text-faint">
                {copy.technologiesLabel}
              </p>
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {group.technologies.map((technology) => (
                  <li>
                    <span class="tag">{technology}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </article>
      ))}
    </div>

    <p class="mt-10 max-w-2xl border-l-2 border-line-strong pl-5 text-sm leading-relaxed text-muted">
      {copy.note}
    </p>
  </div>
</BaseLayout>
